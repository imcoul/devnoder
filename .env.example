# Copy this file to .env and fill in the real values for your Cloudflare/GitHub setup.
# NEVER commit the real .env file with secrets in it.
# These values are used for local deployment and Worker configuration, not for browser-side app logic.

# Cloudflare account credentials used by Wrangler to deploy workers/pages and read account resources.
# Role: authenticates CLI deploys and allows access to D1/R2/Workers in your Cloudflare account.
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"

# Cloudflare account identifier for the target account.
# Role: ties CLI commands to the correct account when deploying or managing resources.
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_here"

# D1 database ID for the app's primary database.
# Role: identifies the devnoder DB that the executor Worker and app expect to connect to.
DATABASE_ID="your_d1_database_id_here"

# GitHub OAuth App client ID.
# Role: used in the OAuth login flow to identify the app when redirecting to GitHub.
# The front-end startup flow and the OAuth Worker both expect a real GitHub OAuth app here.
GITHUB_CLIENT_ID="your_github_oauth_client_id_here"

# Vite exposes only variables prefixed with VITE_ to browser code.
# Role: lets the browser start the GitHub authorization redirect; this is public, unlike the secret.
VITE_GITHUB_CLIENT_ID="your_github_oauth_client_id_here"

# GitHub OAuth App client secret.
# Role: exchanged server-side for a short-lived access token in the OAuth Worker.
# This must be kept secret and set on the devnoder-oauth Worker using Wrangler secrets.
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret_here"

# GitHub personal access token (PAT).
# Role: optional but useful for GitHub API calls that need elevated permissions outside the OAuth flow.
# Use only if you have a real token for repo/PR/API automation; do not create one unless needed.
GITHUB_OAUTH_PAT="your_github_pat_here"

# Optional runtime environment name.
# Role: helps distinguish local/dev/staging/production when the app or Workers behave differently.
ENVIRONMENT="development"

# Optional: if you later add a custom API base or private service endpoint.
# Role: override default service URLs for local or staging environments.
# DEVNODER_API_BASE="https://your-worker-domain.example.com"
